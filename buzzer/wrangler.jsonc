// The buzzer room: `npx wrangler dev` to run it locally, `npx wrangler deploy` to publish it (see README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brainrot-buzzer",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // Builds the phone page (phone/ → dist/index.html) before dev and deploy.
  "build": { "command": "node build.mjs", "watch_dir": "phone" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /ABCD (a room code) serves the phone page.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "BUZZ_ROOM", "class_name": "BuzzRoom" },
      // One instance: counts the rooms made today (src/limits.ts).
      { "name": "ROOM_COUNTER", "class_name": "RoomCounter" }
    ]
  },
  // SQLite-backed Durable Objects work on the Workers Free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BuzzRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomCounter"] }
  ],
  // New rooms per address: 6 a minute (Workers Rate Limiting; no extra cost, works on Free and in wrangler dev).
  // namespace_id is any number of our own, unique within the account.
  // Room lookups (GET /api/rooms/:code) and phone connections per address, so nobody can try every code to find live
  // rooms: 60 and 120 a minute (a phone looks up once and reconnects with a growing wait).
  "ratelimits": [
    { "name": "NEW_ROOM_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "LOOKUP_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "PHONE_LIMIT", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ]
}
