// The buzzer room: `npx wrangler dev` to run it locally, `npx wrangler deploy` to publish it (see README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brainrot-buzzer",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // Builds the phone page (phone/ → dist/index.html) before dev and deploy.
  "build": { "command": "node build.mjs", "watch_dir": "phone" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /ABCD (a room code) serves the phone page.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "BUZZ_ROOM", "class_name": "BuzzRoom" },
      // One instance: counts the rooms made today (src/limits.ts).
      { "name": "ROOM_COUNTER", "class_name": "RoomCounter" }
    ]
  },
  // SQLite-backed Durable Objects work on the Workers Free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BuzzRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomCounter"] }
  ],
  // New rooms per address: 6 a minute (Workers Rate Limiting; no extra cost, works on Free and in wrangler dev).
  // namespace_id is any number of our own, unique within the account.
  // Room lookups (GET /api/rooms/:code) and connections (/ws/) per address, so nobody can try every code to find live
  // rooms: 60 and 120 a minute (a phone looks up once and reconnects with a growing wait; the host connects once).
  // Card file uploads and downloads per address: 120 a minute each (a clue's cards hold a few files at most).
  "ratelimits": [
    { "name": "NEW_ROOM_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "LOOKUP_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "SOCKET_LIMIT", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "FILE_LIMIT", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
  ],
  // Workers Logs: each request's CPU and wall time, the room's (Durable Object) calls included, in the dashboard
  // (Workers & Pages › brainrot-buzzer › Observability), for measuring what card files cost (README.md, "Card files").
  // Query strings are left out of the logged addresses: the host's connection carries the room's host token in one.
  // (It's here, not just switched on in the dashboard: a deploy without it switches it off again.)
  "observability": { "enabled": true, "redact_query_string": true },
  // Card files (pictures, GIFs, videos and sounds on private cards), in MB (MiB: 1024 × 1024 bytes). The app asks the
  // server for these (/api/health, the host's welcome), so changing them here is all it takes. See README.md, "Card files".
  "vars": {
    // How big one file may be. Cloudflare turns away a request body over the plan's limit before it reaches the Worker
    // (Free and Pro 100 MB, Business 200 MB, Enterprise 500 MB): keep this a little under it.
    "FILE_MB": "16",
    // A room's files together (it holds 32 files at most too), deleted 10 minutes after no card uses them (and 20 hours
    // after their upload at most). Check the plan's storage per Durable Object before raising it (on Free, 1 GB each).
    "ROOM_FILES_MB": "64",
    // What the whole server takes in any 24 hours (counted by the hour): further uploads are refused until enough of it
    // frees, and the host copies the card instead. 0 turns card files off. No file is kept more than 20 hours, so the
    // files kept are never more than this: keep it under the plan's storage in all (on Free, 5 GB, which every room's
    // own state needs some of too).
    "FILES_MB_PER_DAY": "2000"
  }
}
