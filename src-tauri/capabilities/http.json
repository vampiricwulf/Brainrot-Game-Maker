{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "http",
  "description": "Native downloads of online media links, from the host window only: any web address on any port except this computer's own (localhost). Redirects are checked too (plugins.http.scopeRedirects in tauri.conf.json).",
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*:*" },
        { "url": "http://*:*" }
      ],
      "deny": [
        { "url": "http://localhost:*" },
        { "url": "https://localhost:*" },
        { "url": "http://*.localhost:*" },
        { "url": "https://*.localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "https://127.0.0.1:*" },
        { "url": "http://[\\:\\:1]:*" },
        { "url": "https://[\\:\\:1]:*" },
        { "url": "http://0.0.0.0:*" },
        { "url": "https://0.0.0.0:*" }
      ]
    }
  ]
}
